-- Rotas da API REST (sem frontend e sem autenticação).
-- Sintaxe: https://www.yesodweb.com/book/routing-and-handlers

/static StaticR Static appStatic

/favicon.ico FaviconR GET
/robots.txt  RobotsR  GET

-- Status da API
/ HomeR GET

-- Cursos (CRUD)
/cursos            CursosR GET POST
/cursos/#CursoId   CursoR  GET PUT DELETE

-- Consulta de CEP na API externa ViaCEP
/cep/#Text   CepR   GET

-- Endereço do aluno, preenchido com dados do ViaCEP
/alunos/#AlunoId/endereco  EnderecoR  GET POST PUT DELETE