-- Rotas da API REST (sem frontend e sem autenticação).
-- Sintaxe: https://www.yesodweb.com/book/routing-and-handlers

/static StaticR Static appStatic

/favicon.ico FaviconR GET
/robots.txt  RobotsR  GET

-- Status da API
/ HomeR GET

-- Cursos (CRUD)
/cursos            CursosR GET POST
/cursos/#CursoId   CursoR  GET PUT DELETE

-- Consulta de CEP na API externa ViaCEP
/cep/#Text   CepR   GET

-- Endereço do aluno, preenchido com dados do ViaCEP
/alunos/#AlunoId/endereco  EnderecoR  GET POST PUT DELETE
-- Alunos
/alunos            AlunosR GET POST
/alunos/#AlunoId   AlunoR  GET PUT DELETE

-- Matriculas
/matriculas                     MatriculasR       GET POST
/matriculas/#MatriculaId        MatriculaR        GET PUT DELETE
/alunos/#AlunoId/matriculas     AlunoMatriculasR  GET
/turmas/#TurmaId/matriculas     TurmaMatriculasR  GET

-- Notas
/notas                          NotasR            GET POST
/notas/#NotaId                  NotaR             GET PUT DELETE
/matriculas/#MatriculaId/notas  MatriculaNotasR   GET
/alunos/#AlunoId/boletim        AlunoBoletimR     GET

-- Professores (CRUD)
/professores            ProfessoresR GET POST
/professores/#ProfessorId ProfessorR  GET PUT DELETE

-- Disciplinas (CRUD)
/disciplinas                DisciplinasR GET POST
/disciplinas/#DisciplinaId  DisciplinaR  GET PUT DELETE

-- Turmas (CRUD)
/turmas            TurmasR GET POST
/turmas/#TurmaId   TurmaR  GET PUT DELETE
